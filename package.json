{
  "name": "automix",
  "version": "1.0.0",
  "description": "Production-Ready Automated Job Application Agent",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "tsx watch src/server/index.ts",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "build": "tsc && cd client && npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "playwright": "^1.63.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
